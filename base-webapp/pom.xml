<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.mmbase</groupId>
    <artifactId>mmbase-parent</artifactId>
    <version>1.9-SNAPSHOT</version>
    <relativePath>../maven-base/pom.xml</relativePath>
  </parent>

  <artifactId>base-webapp</artifactId>
  <packaging>war</packaging>
  <name>MMBase Base webapp</name>
  <version>${base.version}</version>

  <properties>
    <standard.scope>runtime</standard.scope>
    <my.postfix>${mmbase.version.postfix}</my.postfix>
    <base.version>${mmbase.version.number}${my.postfix}</base.version>
  </properties>

  <description>
    This is a minimalistic war containing the essentials for an MMBase web applications.
    This can be used as initial war overlay for your own project.
  </description>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-war-plugin</artifactId>
        <configuration>
          <archiveClasses>false</archiveClasses>
          <attachClasses>false</attachClasses>
        </configuration>
      </plugin>

    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>org.mmbase</groupId>
      <artifactId>mmbase</artifactId>
      <version>${mmbase.version}</version>
    </dependency>

    <!--
         admin pages, generic editors templates use mmbase taglib
         So it is more or less essential.
    -->
    <dependency>
      <groupId>org.mmbase</groupId>
      <artifactId>mmbase-taglib</artifactId>
      <version>${mmbase.version}</version>
      <type>war</type>
    </dependency>
<!-- TODO mmbase-repo
    <dependency>
      <groupId>org.mmbase.jquery</groupId>
      <artifactId>jquery-form</artifactId>
      <version>2.82</version>
      <type>war</type>
    </dependency>-->

    <dependency>
      <groupId>javax.servlet</groupId>
      <artifactId>jstl</artifactId>
    </dependency>
    <dependency>
      <groupId>taglibs</groupId>
      <artifactId>standard</artifactId>
      <scope>${standard.scope}</scope>
    </dependency>

    <dependency>
      <groupId>log4j</groupId>
      <artifactId>log4j</artifactId>
    </dependency>


    <!-- To be able to compress javascript (e.g. mmbase/validation/validation.js.jsp is compressed on the fly) -->
    <dependency>
      <groupId>com.yahoo.platform.yui</groupId>
      <artifactId>yuicompressor</artifactId>
      <version>2.4.8</version>
    </dependency>
    <!-- actually, we use this now for compression of javascript. yuicompressor still used for css  -->
    <dependency>
      <groupId>com.google.javascript</groupId>
      <artifactId>closure-compiler</artifactId>
      <version>v20220202</version>
    </dependency>


    <dependency>
      <groupId>opensymphony</groupId>
      <artifactId>oscache</artifactId>
      <version>2.4.1</version> <!-- do not use 2.4.1, because then you also need commons logging -->
      <exclusions>
        <exclusion>
          <groupId>commons-logging</groupId>
          <artifactId>commons-logging</artifactId>
        </exclusion>
        <exclusion>
          <!-- we never used jms-->
          <groupId>javax.jms</groupId>
          <artifactId>jms</artifactId>
        </exclusion>
        <exclusion>
          <!-- provided by tomcat-->
          <groupId>javax.servlet</groupId>
          <artifactId>servlet-api</artifactId>
        </exclusion>
      </exclusions>
    </dependency>



  </dependencies>


  <profiles>
    <profile>
      <id>deploy</id>
      <build>
        <defaultGoal>deploy</defaultGoal>
      </build>
    </profile>
    <profile>
      <id>servlet25</id>
      <activation>
        <property>
          <name>servlet.version</name>
          <value>2.5</value>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>javax.servlet</groupId>
          <artifactId>jstl</artifactId>
          <version>1.2</version>
        </dependency>
      </dependencies>
      <properties>
        <base.version>${mmbase.version.number}-servlet25${mmbase.version.postfix}</base.version>
        <standard.scope>provided</standard.scope>
      </properties>
    </profile>
    <profile>
      <id>development</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.mmbase.maven</groupId>
            <artifactId>maven-mmbase-plugin</artifactId>
            <version>1.9-SNAPSHOT</version>
            <executions>
              <execution>
                <id>installsvnsr</id>
                <phase>compile</phase>
                <goals>
                  <goal>include-default-excludes</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

  </profiles>
</project>
